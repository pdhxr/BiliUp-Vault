{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BiliUp",
  "identifier": "com.biliup.desktop",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:*"
    },
    "windows": [
      {
        "label": "main",
        "title": "BiliUp",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "externalBin": ["binaries/biliup-backend"]
  }
}
